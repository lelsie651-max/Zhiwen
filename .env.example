APP_NAME=zhiwen
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-local-env
DATABASE_URL=postgresql+asyncpg://zhiwen:zhiwen@localhost:5432/zhiwen
PORT=8000
UPLOAD_TEMP_DIR=./data/tmp
FILE_STORAGE_ROOT=./data/files
MAX_UPLOAD_BYTES=26214400
UPLOAD_CHUNK_BYTES=1048576
PROCESSING_STALE_MINUTES=30
BAILIAN_TOOL_TOKEN=

# LLM (OpenAI-compatible). Fill LLM_API_KEY with your own key at deploy time.
# DeepSeek official:  LLM_BASE_URL=https://api.deepseek.com                          LLM_MODEL=deepseek-v4-flash
# Alibaba Bailian:    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=deepseek-v3
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
